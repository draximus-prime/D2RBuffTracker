<Window x:Class="D2RBuffTracker.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:D2RBuffTracker.Overlay"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance overlay:OverlayViewModel}"
        Title="D2R Buff Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Grid x:Name="RootScale">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- Faint frame only visible while positioning the overlay -->
        <Border x:Name="PreviewFrame" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreview}" Value="True">
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="BorderBrush" Value="#7C4DFF" />
                            <Setter Property="Background" Value="#22000000" />
                            <Setter Property="Padding" Value="6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="True">
                <!-- Positioning hint: below the icons in landscape, rotated sideways when stacked vertically -->
                <TextBlock x:Name="HintText" Text="Drag to position  •  set size in the app"
                           Foreground="White" FontWeight="SemiBold" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"
                           Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Orientation}" Value="Vertical">
                                    <Setter Property="DockPanel.Dock" Value="Right" />
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Items}" Margin="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding Orientation}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type overlay:BuffTimerViewModel}">
                            <StackPanel Width="72" Margin="4">
                                <Grid Width="72" Height="72">
                                    <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                           Stretch="Uniform" IsHitTestVisible="False" />
                                    <!-- Radial cooldown sweep over the icon -->
                                    <overlay:RadialCooldown x:Name="Swipe" ClipToBounds="True"
                                            IsHitTestVisible="False"
                                            Progress="{Binding Progress}"
                                            Visibility="{Binding DataContext.ShowSwipe, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                    <!-- Semi-transparent colour wash over the whole icon on warning -->
                                    <Border x:Name="IconTint" Opacity="0.3" Background="Transparent"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>

                                <!-- Countdown number below the icon -->
                                <TextBlock x:Name="DigitText" Text="{Binding DisplaySeconds}"
                                           Visibility="{Binding DataContext.ShowDigits, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"
                                           FontSize="{Binding DataContext.DigitFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontWeight="Bold" Foreground="White">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAmber}" Value="True">
                                    <Setter TargetName="IconTint" Property="Background" Value="#FFFFB000" />
                                    <Setter TargetName="IconTint" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter TargetName="IconTint" Property="Background" Value="#FFFF3B3B" />
                                    <Setter TargetName="IconTint" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- Expired: keep the icon red and hide the "0" as a recast reminder -->
                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                    <Setter TargetName="IconTint" Property="Background" Value="#FFFF3B3B" />
                                    <Setter TargetName="IconTint" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="DigitText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1.0" To="0.35" Duration="0:0:0.55"
                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <!-- Replace the flash (default handoff stops it) and settle back to full opacity. -->
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
