<UserControl x:Class="D2RBuffTracker.Views.BuffsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:D2RBuffTracker.ViewModels"
             xmlns:models="clr-namespace:D2RBuffTracker.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="640" d:DesignWidth="800">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Buffs" Style="{StaticResource SectionTitle}" FontSize="26" />
            <TextBlock Style="{StaticResource SectionCaption}"
                       Text="Pick a profile, then add the buffs you want to keep an eye on. Bind the keys you press in game and the overlay counts them down for you." />
        </StackPanel>

        <!-- Profile toolbar -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Person24" Margin="0,0,10,0" />
                    <TextBlock Text="Profile" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                    <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}" Content="New"
                               Click="NewProfile_OnClick" ToolTip="Create a new profile" />
                    <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Rename24}"
                               Click="RenameProfile_OnClick" ToolTip="Rename profile" />
                    <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                               Click="DeleteProfile_OnClick" ToolTip="Delete profile" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="40"
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                Visibility="{Binding HasBuffs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Sparkle24" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="No buffs yet" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Add your first buff to start tracking. Browse the class gallery to quickly pick skills like Battle Orders, Frozen Armor or Hurricane." />
                <ui:Button Appearance="Primary" Margin="0,20,0,0" HorizontalAlignment="Center"
                           Icon="{ui:SymbolIcon Add24}" Content="Add your first buff"
                           Click="AddBuff_OnClick" />
            </StackPanel>
        </Border>

        <!-- Buff cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasBuffs, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding CurrentBuffs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TrackedBuff}">
                        <Border Style="{StaticResource GlassCard}" Width="250" Margin="0,0,14,14" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- top: icon + name + class -->
                                <Grid Margin="14,14,14,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="52" Height="52" Background="Transparent" BorderThickness="0">
                                        <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border HorizontalAlignment="Left" Margin="0,4,0,0" CornerRadius="6"
                                                Padding="6,1"
                                                Background="{Binding Class, Converter={StaticResource ClassAccentConverter}}">
                                            <TextBlock Text="{Binding Class}" FontSize="11" Foreground="#101014"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- middle: details -->
                                <StackPanel Grid.Row="1" Margin="14,4,14,10">
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Duration" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock HorizontalAlignment="Right">
                                            <Run Text="{Binding Duration}" /><Run Text=" s" />
                                        </TextBlock>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Select key" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding SelectKey, Converter={StaticResource BindingLabel}}" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="Use key" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   Text="{Binding UseKey, Converter={StaticResource BindingLabel}}" />
                                    </Grid>
                                </StackPanel>

                                <!-- bottom: actions -->
                                <Border Grid.Row="2" Background="#18000000" CornerRadius="0,0,10,10" Padding="8,6">
                                    <Grid>
                                        <ui:ToggleSwitch HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                         Click="Enable_OnClick" ToolTip="Enable / disable tracking" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="Edit"
                                                       Click="EditBuff_OnClick" Tag="{Binding}" />
                                            <ui:Button Margin="6,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                                       Click="DeleteBuff_OnClick" Tag="{Binding}"
                                                       ToolTip="Remove" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Floating add button -->
        <ui:Button Grid.Row="2" Appearance="Primary" Height="46" MinWidth="150"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                   Icon="{ui:SymbolIcon Add24}" Content="Add buff"
                   Click="AddBuff_OnClick"
                   Visibility="{Binding HasBuffs, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
