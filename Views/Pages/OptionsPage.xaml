<UserControl x:Class="D2RBuffTracker.Views.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:D2RBuffTracker.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="640" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Options" Style="{StaticResource SectionTitle}" FontSize="26" />
            <TextBlock Style="{StaticResource SectionCaption}"
                       Text="Fine-tune how the overlay looks and behaves. While the Buff Tracker window is open, a draggable preview of the overlay appears on screen — drag it where you want it to sit in game." />

            <!-- Overlay layout -->
            <Border Style="{StaticResource GlassCard}" Margin="0,4,0,14">
                <StackPanel>
                    <TextBlock Text="Overlay layout" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Grid Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Overlay size" />
                            <TextBlock Text="Scale the overlay icons up or down."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ScaleValue" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="34"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Slider x:Name="ScaleSlider" Width="170" Minimum="0.5" Maximum="2.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="ScaleSlider_OnValueChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Vertical stack" />
                            <TextBlock Text="Stack buff icons top-to-bottom instead of left-to-right."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="VerticalSwitch" HorizontalAlignment="Right"
                                         IsChecked="{Binding Settings.IsOverlayVertical, Mode=TwoWay}"
                                         Click="Layout_OnChanged" />
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Add new buffs to the start" />
                            <TextBlock Text="Newly activated buffs appear first rather than last."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding Settings.InsertNewToStart, Mode=TwoWay}"
                                         Click="Save_OnChanged" />
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Show countdown digits" />
                            <TextBlock Text="Display the remaining seconds on each icon."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding Settings.ShowDigits, Mode=TwoWay}"
                                         Click="Digits_OnChanged" />
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Cooldown sweep" />
                            <TextBlock Text="Show a radial sweep over each icon as the buff runs down."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding Settings.ShowCooldownSwipe, Mode=TwoWay}"
                                         Click="Swipe_OnChanged" />
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Play sounds" />
                            <TextBlock Text="Master switch for all warning and expire sounds. Turn off to silence everything."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right"
                                         IsChecked="{Binding Settings.SoundsEnabled, Mode=TwoWay}"
                                         Click="Save_OnChanged" />
                    </Grid>

                    <Grid Margin="0,8">
                        <StackPanel>
                            <TextBlock Text="Countdown text size" />
                            <TextBlock Text="Scale the countdown number under each icon."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="DigitSizeValue" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="34"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Slider x:Name="DigitSizeSlider" Width="170" Minimum="10" Maximum="48"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="DigitSizeSlider_OnValueChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Grid Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Theme" />
                            <TextBlock Text="Choose the app appearance."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Width="160" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" SelectionChanged="Theme_OnChanged">
                            <ComboBoxItem Content="Dark" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="System" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Keep running when closed" />
                            <TextBlock Text="Closing the window minimises it to the tray and keeps tracking. Turn off to exit on close."
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding Settings.MinimizeToTrayOnClose, Mode=TwoWay}"
                                         Click="Save_OnChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <ui:Button Content="Reset options to defaults" Margin="0,16,0,0"
                       HorizontalAlignment="Left" Icon="{ui:SymbolIcon ArrowReset24}"
                       Click="Reset_OnClick"
                       ToolTip="Restore all overlay and appearance options to their defaults" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
