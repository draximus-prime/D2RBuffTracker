<ui:FluentWindow x:Class="D2RBuffTracker.Views.SoundGalleryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Choose a sound"
                 Width="760" Height="560"
                 MinWidth="640" MinHeight="460"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Choose a sound" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Category filter -->
            <Border Style="{StaticResource GlassCard}" Padding="6" Margin="0,0,14,0">
                <ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="CategoryList_OnSelectionChanged" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,12"
                            PlaceholderText="Search sounds..."
                            Icon="{ui:SymbolIcon Search24}"
                            TextChanged="SearchBox_OnTextChanged" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SoundItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="150" Height="70" Margin="0,0,12,12"
                                        Style="{StaticResource TileButton}"
                                        Click="SoundTile_OnClick" Tag="{Binding Id}">
                                    <Border Style="{StaticResource GlassCard}" Padding="10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="22"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"
                                                           FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Category}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="16,14,16,16">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Selected:" />
                <Run x:Name="SelectedLabel" Text="none" FontWeight="SemiBold" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Pick your own file" Icon="{ui:SymbolIcon FolderOpen24}"
                           MinWidth="140" Click="Browse_OnClick" />
                <ui:Button x:Name="PreviewButton" Content="Preview" Icon="{ui:SymbolIcon Play24}"
                           MinWidth="110" Margin="8,0,0,0" Click="Preview_OnClick" IsEnabled="False" />
                <ui:Button Content="Use this sound" Appearance="Primary" Margin="8,0,0,0" MinWidth="130"
                           x:Name="UseButton" Click="Use_OnClick" IsEnabled="False" />
                <ui:Button Content="Cancel" Margin="8,0,0,0" MinWidth="90" Click="Cancel_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
