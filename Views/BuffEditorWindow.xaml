<ui:FluentWindow x:Class="D2RBuffTracker.Views.BuffEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Edit buff"
                 Width="670" Height="560"
                 MinWidth="650" MinHeight="520"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit buff" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,0">
            <StackPanel>
                <!-- Icon + name -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Width="84" Height="84" Background="Transparent" BorderThickness="0">
                                <Image x:Name="IconPreview" Stretch="Uniform" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Name" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="NameBox" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:ToggleSwitch x:Name="EnabledSwitch" Content="Enabled for tracking" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Duration -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Duration" FontWeight="SemiBold" />
                            <TextBlock Text="The buff's total length in seconds — check the skill description in game if you're unsure."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ui:NumberBox x:Name="DurationBox" Width="140" HorizontalAlignment="Right"
                                      Minimum="1" Maximum="3600" SmallChange="1" LargeChange="5"
                                      ClearButtonEnabled="False"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Warnings -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Warnings" FontWeight="SemiBold" />
                        <TextBlock Text="Change this buff's icon colour as it runs low, and optionally play a sound. Amber always triggers before red."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <!-- Amber threshold -->
                        <Border CornerRadius="8" Background="#22FFB000" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Amber warning" FontWeight="SemiBold" />
                                        <TextBlock Text="Turn amber when this many seconds remain. 0 disables it."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:NumberBox x:Name="AmberSecondsBox" Width="140" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Minimum="0" Maximum="600" SmallChange="1"
                                                  ClearButtonEnabled="False" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ToggleSwitch x:Name="AmberSoundSwitch" VerticalAlignment="Center" />
                                        <TextBlock Text="Play a sound" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="AmberSoundLabel" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   MaxWidth="130" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Icon="{ui:SymbolIcon Play24}" Click="PreviewAmber_OnClick" ToolTip="Preview sound" />
                                        <ui:Button Content="Choose" Margin="6,0,0,0" Icon="{ui:SymbolIcon MusicNote224}"
                                                   Click="ChooseAmber_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Red threshold -->
                        <Border CornerRadius="8" Background="#22FF3B3B" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Red warning" FontWeight="SemiBold" />
                                        <TextBlock Text="Turn red when this many seconds remain. 0 disables it."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:NumberBox x:Name="RedSecondsBox" Width="140" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Minimum="0" Maximum="600" SmallChange="1"
                                                  ClearButtonEnabled="False" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ToggleSwitch x:Name="RedSoundSwitch" VerticalAlignment="Center" />
                                        <TextBlock Text="Play a sound" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="RedSoundLabel" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   MaxWidth="130" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Icon="{ui:SymbolIcon Play24}" Click="PreviewRed_OnClick" ToolTip="Preview sound" />
                                        <ui:Button Content="Choose" Margin="6,0,0,0" Icon="{ui:SymbolIcon MusicNote224}"
                                                   Click="ChooseRed_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Expire sound -->
                        <Border CornerRadius="8" Background="#22808080" Padding="12" Margin="0,8,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="ExpireSoundSwitch" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Expire sound" FontWeight="SemiBold" />
                                        <TextBlock Text="Play a sound the moment this buff runs out."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpireSoundLabel" VerticalAlignment="Center" Margin="0,0,10,0"
                                               MaxWidth="130" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Icon="{ui:SymbolIcon Play24}" Click="PreviewExpire_OnClick" ToolTip="Preview sound" />
                                    <ui:Button Content="Choose" Margin="6,0,0,0" Icon="{ui:SymbolIcon MusicNote224}"
                                               Click="ChooseExpire_OnClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Keys -->
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                        <TextBlock Text="Key bindings" FontWeight="SemiBold" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Click Bind, then press the actual key, mouse or gamepad button you use in game. If you set a select key, the overlay only fires after select then use are pressed in sequence." />

                        <!-- Select key -->
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Select key (optional)" />
                                <TextBlock x:Name="SelectLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" Text="Not set" />
                            </StackPanel>
                            <ui:Button x:Name="SelectBindBtn" Grid.Column="1" Content="Bind"
                                       Icon="{ui:SymbolIcon Keyboard24}" Click="BindSelect_OnClick" MinWidth="110" />
                            <ui:Button Grid.Column="2" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}"
                                       Click="ClearSelect_OnClick" ToolTip="Clear" />
                        </Grid>

                        <!-- Use key -->
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Use key" />
                                <TextBlock x:Name="UseLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="12" Text="Not set" />
                            </StackPanel>
                            <ui:Button x:Name="UseBindBtn" Grid.Column="1" Content="Bind"
                                       Icon="{ui:SymbolIcon Keyboard24}" Click="BindUse_OnClick" MinWidth="110" />
                            <ui:Button Grid.Column="2" Margin="6,0,0,0" Icon="{ui:SymbolIcon Dismiss24}"
                                       Click="ClearUse_OnClick" ToolTip="Clear" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="20,14,20,18">
            <ui:Button Content="Reset to defaults" HorizontalAlignment="Left"
                       Icon="{ui:SymbolIcon ArrowReset24}" Click="Reset_OnClick"
                       ToolTip="Restore duration, warnings and sounds to their defaults" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" MinWidth="90" Click="Cancel_OnClick" />
                <ui:Button Content="Save" Appearance="Primary" Margin="8,0,0,0" MinWidth="90"
                           Click="Save_OnClick" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
