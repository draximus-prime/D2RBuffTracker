<ui:FluentWindow x:Class="D2RBuffTracker.Views.BuffGalleryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:D2RBuffTracker.Views"
                 Title="Add a buff"
                 Width="820" Height="600"
                 MinWidth="720" MinHeight="500"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add a buff" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Class filter -->
            <Border Style="{StaticResource GlassCard}" Padding="6" Margin="0,0,14,0">
                <ListBox x:Name="ClassList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="ClassList_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,10,0"
                                        Background="{Binding Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,12"
                            PlaceholderText="Search buffs..."
                            Icon="{ui:SymbolIcon Search24}"
                            TextChanged="SearchBox_OnTextChanged" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BuffItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="120" Height="132" Margin="0,0,12,12"
                                        Style="{StaticResource TileButton}"
                                        Click="BuffTile_OnClick" Tag="{Binding Entry}">
                                    <Border Style="{StaticResource GlassCard}" Padding="10">
                                        <StackPanel>
                                            <Border Width="72" Height="72" Background="Transparent"
                                                    BorderThickness="0" HorizontalAlignment="Center">
                                                <Image Source="{Binding IconPath, Converter={StaticResource IconConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" TextAlignment="Center"
                                                       TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,16,16">
            <ui:Button Content="Create custom buff" Icon="{ui:SymbolIcon Wand24}"
                       Click="Custom_OnClick" MinWidth="150" />
            <ui:Button Content="Cancel" Margin="8,0,0,0" MinWidth="90" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
